# Default OpenAI-compatible model shared by all three roles. Copy to .env before editing.
# Keep real credentials out of Git; this file must contain placeholders only.
LLM_API_KEY=replace-with-provider-api-key
LLM_MODEL=gpt-4o-mini
# Leave blank to use the SDK's default OpenAI endpoint.
LLM_BASE_URL=
# Sampling temperature: 0 to 2.
LLM_TEMPERATURE=0.7
# Positive model-call and graceful-shutdown timeout in seconds.
LLM_TIMEOUT_SECONDS=60
# Chat overrides: blank fields inherit the corresponding LLM_* default.
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=
CHAT_LLM_BASE_URL=
CHAT_LLM_TEMPERATURE=
CHAT_LLM_TIMEOUT_SECONDS=

# Number of recent completed messages included in each model prompt: 1 to 200.
CHAT_CONTEXT_MESSAGE_LIMIT=40
# Business tables and LangGraph Saver tables share this one SQLite file.
SQLITE_DB_PATH=data/chatbot.sqlite3

# Emotion analysis runs when the gate triggers; blank connection overrides inherit LLM_*.
EMOTION_LLM_API_KEY=
EMOTION_LLM_MODEL=
EMOTION_LLM_BASE_URL=
EMOTION_LLM_TEMPERATURE=
# Blank inherits LLM_TIMEOUT_SECONDS. Emotion calls never retry automatically.
EMOTION_LLM_TIMEOUT_SECONDS=
# REQUIRED: actual context window of the deployed emotion model, in tokens.
EMOTION_CONTEXT_TOKENS=
# REQUIRED: supported tokenizer/chat-template model matching that service.
# Do not substitute an unrelated OpenAI tokenizer for a private model.
EMOTION_TOKENIZER_MODEL=
EMOTION_OUTPUT_TOKENS=1024
EMOTION_SAFETY_TOKENS=256
# Editable emotion configuration under data/config. Restart after changes.
# Relative paths assume startup from the project root.
EMOTION_LABELS_PATH=data/config/emotion_labels.json
EMOTION_FAMILIES_PATH=data/config/emotion_families.json
EMOTION_EXAMPLES_PATH=data/config/emotion_examples.json
# Optional JSON file with the chatbot system prompt ("version" and "system" keys).
# Leave blank to use data/config/prompts/chat_prompts.json (or the built-in default if absent).
CHAT_SYSTEM_PROMPT_PATH=

# 情绪识别提示词；留空读取 data/config/prompts/emotion_prompts.json，每次分析重新加载
EMOTION_SYSTEM_PROMPT_PATH=

# Emotion recognition budget and dynamic few-shot selection.
EMOTION_HISTORY_RATIO=0.60
EMOTION_EXAMPLE_LIMIT=4
EMOTION_PRIOR_BOOST=2.0
EMOTION_RECENT_LABEL_LIMIT=3

# 判定是否需要识别：策略和提示词独立配置，启动时加载，修改后重启。
# 策略默认 max_interval_turns=15、history_turn_limit=5，可改为其他值。
# 留空使用项目内 data/config/emotion_gate.json。
EMOTION_GATE_CONFIG_PATH=
# 留空使用 data/config/prompts/emotion_gate_prompts.json (version/system)。
EMOTION_GATE_SYSTEM_PROMPT_PATH=
# 判定 Agent 留空逐项继承 LLM_* 默认配置，与 Chat、情绪识别独立。
# 判定模型与情绪识别模型不同时，在策略 JSON 显式指定匹配的 context_tokens 和 tokenizer_model。
EMOTION_GATE_LLM_API_KEY=
EMOTION_GATE_LLM_MODEL=
EMOTION_GATE_LLM_BASE_URL=
EMOTION_GATE_LLM_TEMPERATURE=
EMOTION_GATE_LLM_TIMEOUT_SECONDS=
