# Configuration template. Copy to .env before editing. Use placeholders only; never commit real credentials.

# ============================================================================
# 1. Default model
# ============================================================================
# Shared defaults for all three roles. Role-specific values take precedence.
# Blank role fields inherit LLM_* independently; explicit temperature 0 is preserved.
LLM_MODEL=ZHIPU/GLM-5.3
LLM_API_KEY=replace-with-provider-api-key
# Replace YOUR_WORKSPACE_ID with the Beijing Bailian workspace ID.
LLM_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Sampling temperature: 0 to 2.
LLM_TEMPERATURE=0.7
# Positive model-call timeout in seconds; effective role timeouts inform shutdown waits.
LLM_TIMEOUT_SECONDS=60
# Thinking mode: disabled (default) or enabled. Restart after changes.
# DeepSeek V4 uses thinking.type; Bailian GLM-5.3 requires enabled (enable_thinking=true).
LLM_THINKING=enabled
# Bailian GLM-5.3 reasoning depth: low / high / max. Blank uses provider default.
LLM_REASONING_EFFORT=low

# ============================================================================
# 2. Chat model overrides
# ============================================================================
# Each field independently overrides LLM_* defaults.
CHAT_LLM_MODEL=
CHAT_LLM_API_KEY=
CHAT_LLM_BASE_URL=
CHAT_LLM_TEMPERATURE=
CHAT_LLM_TIMEOUT_SECONDS=
# Blank inherits LLM_THINKING; disabled/enabled overrides this role only.
CHAT_LLM_THINKING=
CHAT_LLM_REASONING_EFFORT=

# ============================================================================
# 3. Emotion recognition model overrides
# ============================================================================
# Each field independently overrides LLM_* defaults. Calls never retry automatically.
EMOTION_LLM_MODEL=
EMOTION_LLM_API_KEY=
EMOTION_LLM_BASE_URL=
EMOTION_LLM_TEMPERATURE=
EMOTION_LLM_TIMEOUT_SECONDS=
# Blank inherits LLM_THINKING; disabled/enabled overrides this role only.
EMOTION_LLM_THINKING=
EMOTION_LLM_REASONING_EFFORT=

# ============================================================================
# 4. Emotion gate model overrides
# ============================================================================
# Each field independently overrides LLM_*; other roles do not supply defaults.
# If this model differs from the emotion model, explicitly configure matching
# context_tokens and tokenizer_model in the policy JSON (section 8).
EMOTION_GATE_LLM_MODEL=
EMOTION_GATE_LLM_API_KEY=
EMOTION_GATE_LLM_BASE_URL=
EMOTION_GATE_LLM_TEMPERATURE=
EMOTION_GATE_LLM_TIMEOUT_SECONDS=
# Blank inherits LLM_THINKING; disabled/enabled overrides this role only.
EMOTION_GATE_LLM_THINKING=
EMOTION_GATE_LLM_REASONING_EFFORT=

# ============================================================================
# 5. Chat context and prompt
# ============================================================================
# Recent completed messages included in each model prompt: 1 to 200.
CHAT_CONTEXT_MESSAGE_LIMIT=40
# Blank uses data/config/prompts/chat_prompts.json (or the built-in default if absent).
CHAT_SYSTEM_PROMPT_PATH=
# Delay between complete chat bubbles in the browser; 0 disables pacing (0 to 10000 ms).
CHAT_BUBBLE_GAP_MS=500

# ============================================================================
# 6. Emotion token budget and example selection
# ============================================================================
# Required for every model: actual context window of the deployed service, in tokens.
# No value is inferred from LLM_MODEL or EMOTION_LLM_MODEL.
EMOTION_CONTEXT_TOKENS=1048576
# Required for every model: explicitly select a matching tokenizer/chat template.
# Examples: ZHIPU/GLM-5.3, deepseek-v4-flash (bundled official tokenizers), gpt-4o-mini.
# This identifier is independent of the API model name; unknown identifiers fail startup.
# Do not substitute an unrelated OpenAI tokenizer for a private model.
EMOTION_TOKENIZER_MODEL=ZHIPU/GLM-5.3
# GLM-5.3 output budget includes reasoning as well as the final JSON.
EMOTION_OUTPUT_TOKENS=8192
EMOTION_SAFETY_TOKENS=256
EMOTION_HISTORY_RATIO=0.60
EMOTION_EXAMPLE_LIMIT=4
EMOTION_PRIOR_BOOST=2.0
EMOTION_RECENT_LABEL_LIMIT=3

# ============================================================================
# 7. Emotion data and prompt
# ============================================================================
# Relative paths assume startup from the project root. Restart after data configuration changes.
EMOTION_LABELS_PATH=data/config/emotion_labels.json
EMOTION_FAMILIES_PATH=data/config/emotion_families.json
EMOTION_EXAMPLES_PATH=data/config/emotion_examples.json
# Blank uses data/config/prompts/emotion_prompts.json; reloaded for each analysis.
EMOTION_SYSTEM_PROMPT_PATH=

# ============================================================================
# 8. Emotion gate policy and prompt
# ============================================================================
# Policy and prompt load at startup. Restart after changes.
# Policy defaults: max_interval_turns=15 and history_turn_limit=5; both are configurable.
# Blank uses data/config/emotion_gate.json.
EMOTION_GATE_CONFIG_PATH=
# Blank uses data/config/prompts/emotion_gate_prompts.json (version/system).
EMOTION_GATE_SYSTEM_PROMPT_PATH=

# ============================================================================
# 9. Storage
# ============================================================================
# Business tables and LangGraph Saver tables share this SQLite file.
SQLITE_DB_PATH=data/chatbot.sqlite3
