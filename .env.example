# Preferred generic LLM settings for chat.
LLM_PROVIDER=deepseek
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.7

# Optional emotion-analysis LLM settings.
# Leave EMOTION_LLM_MODEL empty or unset to reuse the chat LLM.
EMOTION_LLM_PROVIDER=
EMOTION_LLM_API_KEY=
EMOTION_LLM_MODEL=
EMOTION_LLM_BASE_URL=
EMOTION_LLM_TEMPERATURE=
EMOTION_INTERVAL=5

# Optional local long-term memory settings.
# Uses Python sqlite3 and stores data locally by default.
MEMORY_ENABLED=true
MEMORY_DB_PATH=data/records/memory.sqlite3
MEMORY_MAX_RESULTS=5

# Legacy chat settings are still accepted when LLM_* values are absent.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_TEMPERATURE=
