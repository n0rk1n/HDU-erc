# 在当前研究工作区复制为 .env，并填写自己的凭据。不要将 .env 提交到 Git。
EMOTION_LLM_API_KEY=
# 可回退到原 LLM_API_KEY；具体实验的模型参数优先写入 config/experiments/*.json。
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_THINKING=disabled
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120
EMOTION_CONTEXT_TOKENS=32768
EMOTION_TOKENIZER_MODEL=deepseek-v4-flash
EMOTION_OUTPUT_TOKENS=4096
EMOTION_SAFETY_TOKENS=256
EXPERIMENT_DATA_DIR=data/research
# EXPERIMENT_DB_PATH=data/research/experiments.sqlite3
