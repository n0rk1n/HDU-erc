# Preferred generic LLM settings for chat.
LLM_PROVIDER=deepseek
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.7

# Optional emotion-analysis LLM settings.
# Leave all EMOTION_LLM_* values empty or unset to reuse the chat LLM.
EMOTION_LLM_PROVIDER=
EMOTION_LLM_API_KEY=
EMOTION_LLM_MODEL=
EMOTION_LLM_BASE_URL=
EMOTION_LLM_TEMPERATURE=
EMOTION_INTERVAL=5

# LangGraph durable conversation state settings.
LANGGRAPH_CHECKPOINT_DB_PATH=data/langgraph/checkpoints.sqlite3
LANGGRAPH_STORE_DB_PATH=data/langgraph/store.sqlite3
LANGGRAPH_TIMELINE_LIMIT=50
LANGGRAPH_REQUEST_HISTORY_LIMIT=64
LANGGRAPH_STRICT_MSGPACK=true
CLIENT_ID_SIGNING_SECRET=replace-with-at-least-32-random-bytes

# Optional local long-term memory settings.
# Uses the configured LangGraph Store.
MEMORY_ENABLED=true
MEMORY_MAX_RESULTS=5
MEMORY_CONSOLIDATION_ENABLED=true
MEMORY_CONSOLIDATION_INTERVAL=5
MEMORY_CONSOLIDATION_WINDOW=12
MEMORY_CONSOLIDATION_MODE=rules

# Optional prompt template settings.
# Defaults to data/config/prompts.json; missing or empty values use built-in prompts.
PROMPT_CONFIG_PATH=data/config/prompts.json

# Legacy chat settings are still accepted when LLM_* values are absent.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_TEMPERATURE=
