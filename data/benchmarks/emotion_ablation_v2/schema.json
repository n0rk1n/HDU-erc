{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Emotion Ablation V2 Case",
  "type": "object",
  "required": [
    "case_id",
    "language",
    "subset",
    "expected",
    "turn_count",
    "history",
    "current_input",
    "scenario",
    "annotation_status"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "pair_id": {"type": "string", "minLength": 1},
    "language": {"enum": ["zh", "en"]},
    "subset": {
      "enum": [
        "core_parallel",
        "extended_independent",
        "challenge",
        "seed",
        "legacy_compat"
      ]
    },
    "seed_group": {"enum": ["core_parallel_seed", "independent_seed"]},
    "target_emotion": {"type": "string"},
    "expected": {"type": "string"},
    "label_provenance": {
      "enum": ["synthetic_generator_target", "human_annotation"]
    },
    "secondary_emotions": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 3
    },
    "intensity": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "ambiguity_level": {"enum": ["low", "medium", "high"]},
    "scenario": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "context_dependency": {"enum": ["none", "low", "medium", "high"]},
    "turn_count": {"type": "integer", "minimum": 1},
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["human", "ai"]},
          "content": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "current_input": {"type": "string", "minLength": 1},
    "evidence_span": {"type": "string"},
    "rationale": {"type": "string"},
    "quality_flags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "annotation_status": {
      "enum": ["candidate", "annotated", "adjudicated", "released", "rejected"]
    },
    "source_stage": {"enum": ["raw", "annotation", "release"]}
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "subset": {"enum": ["core_parallel", "extended_independent", "challenge"]}
        }
      },
      "then": {"required": ["label_provenance"]}
    }
  ]
}
